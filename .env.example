# Local Docker Compose settings. Generate a unique SECRET_KEY before use.
SECRET_KEY=replace-with-a-unique-secret-key
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# PostgreSQL settings (must match docker-compose.yml)
DB_NAME=hostel_db
DB_USER=hostel_user
DB_PASSWORD=hostel_password
DB_HOST=db
DB_PORT=5432
